@model ProfileViewModel
@{ ViewData["Title"] = "My profile"; }
<div class="profile-grid"><form asp-action="Profile" method="post" class="card form-card profile-card"><div asp-validation-summary="ModelOnly"></div><div class="profile-heading"><div class="profile-avatar">@Model.FullName[0]</div><div><h3>@Model.FullName</h3><p>@Model.Email</p></div></div><div class="form-section"><div class="form-section-title"><span>01</span><div><strong>Personal information</strong><small>Keep your profile details current</small></div></div><div class="row g-4"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" placeholder="Optional phone number"/><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div><div class="col-12"><label class="form-label">University email</label><input value="@Model.Email" class="form-control" disabled/><div class="password-rules">Email changes are managed by an administrator.</div></div></div></div><div class="form-footer justify-content-end"><button class="btn-primary">Save profile</button></div></form>
<aside class="card security-card"><span class="security-icon">⌁</span><span class="eyebrow">ACCOUNT SECURITY</span><h3>Protect your account</h3><p>Use a strong, unique password and update it whenever you suspect unauthorized access.</p><div class="security-status"><span>✓</span><div><strong>Password protection active</strong><small>Secured by ASP.NET Core Identity</small></div></div><a class="btn-primary" asp-action="ChangePassword">Change password <span>→</span></a></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
