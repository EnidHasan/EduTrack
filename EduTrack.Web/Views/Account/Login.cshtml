@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="login-page">
    <section class="login-art">
        <div class="login-orb orb-one"></div><div class="login-orb orb-two"></div>
        <a class="brand login-brand" href="/"><img src="~/assets/logo2.png" alt="EduTrack Logo" style="width: 120px; height: 120px; border-radius: 24px; box-shadow: 0 15px 35px rgba(0,0,0,0.4);" /><span>EduTrack<small>Academic management platform</small></span></a>
        <div class="login-copy">
            <span class="login-kicker"><i></i> One connected academic community</span>
            <h1>Academic life,<br/><em>beautifully organized.</em></h1>
            <p>Bring people, courses, and academic operations together in one secure university workspace.</p>
            <div class="login-features"><span>✓ Role-based access</span><span>✓ Trusted academic records</span><span>✓ Built for every department</span></div>
        </div>
        <div class="login-trust"><span class="trust-mark">◎</span><span><strong>Secure by design</strong><small>Identity-protected university access</small></span></div>
    </section>
    <section class="login-panel">
        <div class="login-box">
            <div class="text-center mb-4"><img src="~/assets/logo2.png" alt="EduTrack Logo" style="width: 100px; height: 100px; object-fit: cover; border-radius: 20px; box-shadow: 0 12px 24px rgba(0,0,0,0.15); margin-bottom: 10px;" /></div>
            <span class="eyebrow">WELCOME TO EDUTRACK</span>
            <h2>Access your workspace</h2>
            <p class="login-intro">Enter your university credentials to continue.</p>
            <div class="login-audience" aria-label="Supported account roles">
                <span><i class="bi bi-shield-check"></i> Admin</span>
                <span><i class="bi bi-person-badge"></i> Faculty</span>
                <span><i class="bi bi-mortarboard"></i> Student</span>
            </div>
            <form method="post">
                <input asp-for="ReturnUrl" type="hidden"/>
                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-field"><label asp-for="Email" class="form-label">University email</label><div class="input-wrap"><span class="field-icon"><i class="bi bi-envelope"></i></span><input asp-for="Email" class="form-control" placeholder="you@university.edu" autocomplete="username"/></div><span asp-validation-for="Email" class="text-danger small"></span></div>
                <div class="form-field"><div class="label-row"><label asp-for="Password" class="form-label"></label><span><i class="bi bi-lock-fill"></i> Secure access</span></div><div class="input-wrap password-input-wrap"><span class="field-icon"><i class="bi bi-key"></i></span><input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password"/><button class="password-toggle" type="button" data-password-toggle="Password" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye"></i></button></div><span asp-validation-for="Password" class="text-danger small"></span></div>
                <button class="login-submit" type="submit"><span>Continue to EduTrack</span><b><i class="bi bi-arrow-right"></i></b></button>
            </form>
            <div class="login-security"><span><i class="bi bi-patch-check-fill"></i></span> Your credentials are encrypted and securely protected</div>
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
