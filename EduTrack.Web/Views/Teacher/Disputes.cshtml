@model IEnumerable<EduTrack.Web.Models.RecheckRequest>
@{
    ViewData["Title"] = "Grade Disputes";
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #3b82f6, #8b5cf6);
        --glass-bg: rgba(255, 255, 255, 0.75);
        --glass-border: rgba(255, 255, 255, 0.5);
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .st-container { animation: slideUp 0.5s ease-out forwards; }

    .glass-card {
        background: var(--glass-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: 0 10px 40px -10px rgba(31, 38, 135, 0.15);
        padding: 30px;
    }

    .dispute-card {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 20px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .dispute-card:hover {
        transform: translateY(-4px) scale(1.01);
        box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.1);
        border-color: rgba(148, 163, 184, 0.3);
        z-index: 2;
    }
    
    .status-indicator {
        position: absolute;
        top: 0; left: 0; bottom: 0;
        width: 6px;
    }
    
    .indicator-Pending { background: #f59e0b; }
    .indicator-Approved { background: #10b981; }
    .indicator-Rejected { background: #ef4444; }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 800;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-Pending { background-color: #fef3c7; color: #b45309; }
    .status-Approved { background-color: #d1fae5; color: #047857; }
    .status-Rejected { background-color: #fee2e2; color: #b91c1c; }

    .action-btn {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        color: #475569;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 8px 16px;
        border-radius: 8px;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .action-btn:hover { background: #e2e8f0; color: #0f172a; border-color: #94a3b8; }
    .action-btn.approve { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
    .action-btn.approve:hover { background: #dcfce7; box-shadow: 0 4px 12px rgba(22, 101, 52, 0.2); transform: translateY(-2px); }
    .action-btn.reject { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
    .action-btn.reject:hover { background: #fee2e2; box-shadow: 0 4px 12px rgba(153, 27, 27, 0.2); transform: translateY(-2px); }
    
    .feedback-input {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 8px 12px;
        transition: all 0.2s ease;
    }
    .feedback-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        outline: none;
    }
</style>

<div class="container-fluid py-4 st-container">
    <div class="glass-card mb-5">
        <div class="d-flex justify-content-between align-items-end border-bottom pb-4 mb-4" style="border-color: rgba(226, 232, 240, 0.6) !important;">
            <div>
                <h3 class="fw-bolder text-dark mb-1">Student Grade Disputes</h3>
                <p class="text-muted mb-0">Review and resolve official grade recheck requests</p>
            </div>
            <div class="text-end">
                <div class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                    Pending Actions: @Model.Count(m => m.Status == "Pending")
                </div>
            </div>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="text-muted fs-5 fst-italic">You have no pending or past disputes for your courses.</div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="dispute-card">
                            <div class="status-indicator indicator-@item.Status"></div>
                            
                            <div class="row align-items-center">
                                <!-- Student & Date -->
                                <div class="col-md-4">
                                    <div class="d-flex align-items-center gap-3 mb-2 mb-md-0">
                                        <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 45px; height: 45px; font-size: 1.2rem;">
                                            @item.Student!.FullName[0]
                                        </div>
                                        <div>
                                            <h5 class="fw-bold text-dark mb-1">@item.Student.FullName</h5>
                                            <div class="text-muted small fw-semibold">@item.Student.RollNumber &middot; @item.RequestDate.ToString("MMM dd, hh:mm tt")</div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Course & Grade Info -->
                                <div class="col-md-3">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Course Details</div>
                                    <div class="fw-semibold text-dark">@item.Grade!.Enrollment!.Course!.CourseName</div>
                                    <div class="text-primary small fw-bold">Current Grade: @item.Grade.LetterGrade (@item.Grade.TotalMark)</div>
                                </div>
                                
                                <!-- Actions / Status -->
                                <div class="col-md-5 text-md-end mt-3 mt-md-0">
                                    @if (item.Status == "Pending")
                                    {
                                        <form asp-action="UpdateDisputeStatus" method="post" class="d-flex gap-2 justify-content-md-end align-items-center">
                                            <input type="hidden" name="requestId" value="@item.Id" />
                                            <input type="text" name="comment" class="feedback-input" placeholder="Feedback (optional)" style="max-width: 180px;" />
                                            <button type="submit" name="status" value="Approved" class="action-btn approve" title="Approve Request">✓ Approve</button>
                                            <button type="submit" name="status" value="Rejected" class="action-btn reject" title="Reject Request">✕ Reject</button>
                                            <a href="/Teacher/GradeEntry?enrollmentId=@item.Grade.EnrollmentId" class="action-btn" title="Edit Grades before approving">✎ Edit Marks</a>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column align-items-md-end">
                                            <span class="status-badge status-@item.Status mb-2">
                                                @if(item.Status == "Approved") { <span>✅</span> }
                                                @if(item.Status == "Rejected") { <span>❌</span> }
                                                @item.Status
                                            </span>
                                            <div class="small text-muted fst-italic">Feedback: "@(item.TeacherComment ?? "None")"</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
