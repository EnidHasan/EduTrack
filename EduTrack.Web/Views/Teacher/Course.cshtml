@model IEnumerable<Enrollment>
@{ var course = (Course)ViewBag.Course; ViewData["Title"] = course.CourseCode + " roster"; }
<div class="page-head"><div><h1>@course.CourseCode &middot; @course.CourseName</h1><p>Enter and review student grades for this course.</p></div><div class="d-flex gap-2"><a class="btn-primary" asp-action="Index">&larr; My courses</a></div></div><div class="card table-responsive"><table class="table"><thead><tr><th>Student</th><th>Roll</th><th>Total mark</th><th>Letter grade</th><th>Grade point</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Student?.FullName</td><td>@x.Student?.RollNumber</td><td>@(x.Grade?.TotalMark.ToString("0.00") ?? "—")</td><td>@(x.Grade?.LetterGrade ?? "—")</td><td>@(x.Grade?.GradePoint.ToString("0.00") ?? "—")</td><td><div class="actions"><a class="icon-btn" asp-action="GradeEntry" asp-route-enrollmentId="@x.Id">@(x.Grade is null ? "Enter grade" : "Edit grade")</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No students enrolled in this course.</div>}</div>
