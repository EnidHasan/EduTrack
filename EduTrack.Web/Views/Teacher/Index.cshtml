@model IEnumerable<Course>
@{ ViewData["Title"] = "My courses"; }
<div class="page-head"><div><h1>My courses</h1><p>Courses assigned to you this term.</p></div></div><div class="card table-responsive"><table class="table"><thead><tr><th>Code</th><th>Course title</th><th>Credits</th><th>Semester</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.CourseCode</strong></td><td>@x.CourseName</td><td>@x.CreditHours</td><td>@(x.Semester ?? "—")</td><td><span class="status @(x.IsActive ? "" : "off")">@(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Course" asp-route-id="@x.Id">View roster</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No courses assigned yet.</div>}</div>
