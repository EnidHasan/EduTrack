@model Grade
@{ ViewData["Title"] = Model.Id == 0 ? "Enter grade" : "Edit grade"; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Marks are summed directly out of 100: Quiz 0-20, Attendance 0-10, Midterm 0-20, Final 0-50.</p></div><a class="btn-soft" asp-action="Course" asp-route-id="@(Model.Enrollment?.CourseId)">&larr; Back to roster</a></div><form asp-action="GradeEntry" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><input asp-for="EnrollmentId" type="hidden"/><div asp-validation-summary="ModelOnly"></div><div class="row g-4"><div class="col-md-3"><label asp-for="AssignmentMark" class="form-label"></label><input asp-for="AssignmentMark" class="form-control" step="0.01" min="0" max="20"/><span asp-validation-for="AssignmentMark" class="text-danger small"></span></div><div class="col-md-3"><label asp-for="AttendanceMark" class="form-label"></label><input asp-for="AttendanceMark" class="form-control" step="0.01" min="0" max="10"/><span asp-validation-for="AttendanceMark" class="text-danger small"></span></div><div class="col-md-3"><label asp-for="MidtermMark" class="form-label"></label><input asp-for="MidtermMark" class="form-control" step="0.01" min="0" max="20"/><span asp-validation-for="MidtermMark" class="text-danger small"></span></div><div class="col-md-3"><label asp-for="FinalMark" class="form-label"></label><input asp-for="FinalMark" class="form-control" step="0.01" min="0" max="50"/><span asp-validation-for="FinalMark" class="text-danger small"></span></div><div class="col-12"><button class="btn-primary">Save grade</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
