@model DashboardViewModel
@{ ViewData["Title"] = "Overview"; }
<section class="hero"><span class="eyebrow text-white-50">EDUTRACK CONTROL CENTER</span><h1 class="mt-2">Good to see you, @User.Identity?.Name?.Split('@')[0].</h1><p>Core academic records and access control, clearly organized.</p></section>
<div class="stats"><div class="card stat"><i>◎</i><small>Students</small><strong>@Model.Students</strong></div><div class="card stat"><i>♙</i><small>Teachers</small><strong>@Model.Teachers</strong></div><div class="card stat"><i>◇</i><small>Courses</small><strong>@Model.Courses</strong></div><div class="card stat"><i>⚙</i><small>User accounts</small><strong>@Model.Users</strong></div></div>
<div class="card"><div class="p-4 border-bottom"><h5 class="m-0">Recently added courses</h5></div>@if(Model.RecentCourses.Count == 0){<div class="empty">No courses yet. Start by adding the first course.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Course</th><th>Credits</th><th>Teacher</th></tr></thead><tbody>@foreach(var x in Model.RecentCourses){<tr><td><strong>@x.CourseCode</strong></td><td>@x.CourseName</td><td>@x.CreditHours</td><td>@(x.Teacher?.FullName ?? "Unassigned")</td></tr>}</tbody></table></div>}</div>
