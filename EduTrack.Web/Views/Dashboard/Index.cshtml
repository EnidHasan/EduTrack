@model DashboardViewModel
@{ ViewData["Title"] = "Overview"; var hour = DateTime.Now.Hour; var greeting = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening"; }
<section class="hero dashboard-hero">
    <div class="hero-copy"><span class="hero-kicker"><i></i> Academic operations center</span><h1>@greeting, <em>@User.Identity?.Name?.Split('@')[0]</em></h1><p>Everything you need to manage your academic community, all in one place.</p><div class="hero-actions">@if(User.IsInRole("Admin")){<a asp-controller="Students" asp-action="Create" class="hero-btn">Add a student <span>→</span></a><a asp-controller="Courses" asp-action="Index" class="hero-link">View course catalog</a>}</div></div>
    <div class="hero-visual"><div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="hero-badge"><span>ET</span><small>Connected<br/>campus</small></div></div>
</section>
<div class="section-heading"><div><span class="eyebrow">AT A GLANCE</span><h2>Academic overview</h2></div><span class="updated"><i></i> Live system data</span></div>
<div class="stats">
    <a class="card stat stat-students" asp-controller="Students" asp-action="Index"><div class="stat-top"><i><span>ST</span></i><span class="trend">Explore →</span></div><small>Enrolled students</small><strong>@Model.Students</strong><div class="stat-line"><span></span></div></a>
    <a class="card stat stat-teachers" asp-controller="Teachers" asp-action="Index"><div class="stat-top"><i><span>FC</span></i><span class="trend">Explore →</span></div><small>Faculty members</small><strong>@Model.Teachers</strong><div class="stat-line"><span></span></div></a>
    <a class="card stat stat-courses" asp-controller="Courses" asp-action="Index"><div class="stat-top"><i><span>CR</span></i><span class="trend">Explore →</span></div><small>Active courses</small><strong>@Model.Courses</strong><div class="stat-line"><span></span></div></a>
    <a class="card stat stat-users" asp-controller="Users" asp-action="Index"><div class="stat-top"><i><span>AC</span></i><span class="trend">Manage →</span></div><small>System accounts</small><strong>@Model.Users</strong><div class="stat-line"><span></span></div></a>
</div>
<div class="dashboard-grid">
<section class="card recent-card"><div class="card-heading"><div><span class="eyebrow">CURRICULUM</span><h3>Recently added courses</h3></div><a asp-controller="Courses" asp-action="Index">View all <span>→</span></a></div>
@if(Model.RecentCourses.Count == 0){<div class="empty premium-empty"><span class="empty-illustration">◇</span><h4>Your course catalog is ready</h4><p>Add the first course to begin organizing the university curriculum.</p>@if(User.IsInRole("Admin")){<a class="btn-primary" asp-controller="Courses" asp-action="Create">Add first course</a>}</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Course</th><th>Credits</th><th>Faculty</th></tr></thead><tbody>@foreach(var x in Model.RecentCourses){<tr><td><span class="course-code">@x.CourseCode</span></td><td><strong>@x.CourseName</strong></td><td><span class="credit-pill">@x.CreditHours credits</span></td><td>@(x.Teacher?.FullName ?? "Not assigned")</td></tr>}</tbody></table></div>}
</section>
<aside class="card quick-card"><div class="card-heading"><div><span class="eyebrow">SHORTCUTS</span><h3>Quick actions</h3></div></div><div class="quick-list"><a asp-controller="Students" asp-action="Create"><i>+</i><span><strong>New student</strong><small>Create an academic profile</small></span><b>→</b></a><a asp-controller="Teachers" asp-action="Create"><i>+</i><span><strong>New faculty member</strong><small>Add teaching personnel</small></span><b>→</b></a><a asp-controller="Courses" asp-action="Create"><i>+</i><span><strong>New course</strong><small>Expand the course catalog</small></span><b>→</b></a></div></aside>
</div>
