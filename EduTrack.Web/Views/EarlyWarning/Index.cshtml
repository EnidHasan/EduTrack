@model EduTrack.Web.ViewModels.AtRiskWarningPanelViewModel
@{
    ViewData["Title"] = Model.IsTeacherScope ? "Course At-Risk Warning Panel" : "At-Risk Student Early Warning Panel";
}

<div class="page-head d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-2">
                <i class="bi bi-shield-exclamation me-1"></i> Early Warning Core
            </span>
            @if (Model.IsTeacherScope)
            {
                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 rounded-2">
                    <i class="bi bi-person-badge me-1"></i> Instructor View: @Model.TeacherName
                </span>
            }
            else
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-2">
                    <i class="bi bi-building me-1"></i> System-Wide Administration
                </span>
            }
        </div>
        <h1 class="h2 mb-1 fw-bold text-dark">At-Risk Early Warning Panel</h1>
        <p class="text-muted mb-0">Automatic real-time GPA and attendance risk threshold evaluation for early academic intervention.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="ExportCsv"
           asp-route-department="@Model.SelectedDepartment"
           asp-route-riskLevel="@Model.SelectedRiskLevel"
           asp-route-riskType="@Model.SelectedRiskType"
           asp-route-search="@Model.SearchTerm"
           class="btn btn-outline-secondary d-flex align-items-center gap-2 fw-semibold px-3 py-2 rounded-3">
            <i class="bi bi-download text-primary"></i> Export Report (CSV)
        </a>
    </div>
</div>

<!-- Summary Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat stat-users h-100">
            <div class="stat-top">
                <i class="bi bi-people-fill">
                    <span>EVAL</span>
                </i>
                <span class="trend">Evaluated</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">Total Students Evaluated</small>
            <strong class="d-block text-dark">@Model.TotalStudentsEvaluated</strong>
            <div class="stat-line">
                <span style="width: 100%;"></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat h-100" style="--accent: #dc3545;">
            <div class="stat-top">
                <i class="bi bi-exclamation-octagon-fill">
                    <span>HIGH</span>
                </i>
                <span class="trend">Critical</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">High Risk Students</small>
            <strong class="d-block text-danger">@Model.HighRiskCount</strong>
            <div class="stat-line">
                <span style="width: @(Model.TotalStudentsEvaluated > 0 ? (Model.HighRiskCount * 100 / Model.TotalStudentsEvaluated) : 0)%; background: #dc3545;"></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat h-100" style="--accent: #fd7e14;">
            <div class="stat-top">
                <i class="bi bi-exclamation-triangle-fill">
                    <span>MED</span>
                </i>
                <span class="trend">Warning</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">Medium Risk Students</small>
            <strong class="d-block text-warning">@Model.MediumRiskCount</strong>
            <div class="stat-line">
                <span style="width: @(Model.TotalStudentsEvaluated > 0 ? (Model.MediumRiskCount * 100 / Model.TotalStudentsEvaluated) : 0)%; background: #fd7e14;"></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat h-100" style="--accent: #198754;">
            <div class="stat-top">
                <i class="bi bi-check-circle-fill">
                    <span>OK</span>
                </i>
                <span class="trend">Satisfactory</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">Normal Standing</small>
            <strong class="d-block text-success">@Model.NormalCount</strong>
            <div class="stat-line">
                <span style="width: @(Model.TotalStudentsEvaluated > 0 ? (Model.NormalCount * 100 / Model.TotalStudentsEvaluated) : 0)%; background: #198754;"></span>
            </div>
        </div>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="card p-3 mb-4 shadow-sm">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <!-- Search -->
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by student name or roll number..." />
            </div>
        </div>

        <!-- Department Filter -->
        <div class="col-6 col-md-3">
            <select name="department" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Departments --</option>
                @foreach (var dept in Model.AvailableDepartments)
                {
                    <option value="@dept" selected="@(Model.SelectedDepartment == dept)">@dept</option>
                }
            </select>
        </div>

        <!-- Risk Level Filter -->
        <div class="col-6 col-md-3">
            <select name="riskLevel" class="form-select" onchange="this.form.submit()">
                <option value="All" selected="@(Model.SelectedRiskLevel == "All" || string.IsNullOrEmpty(Model.SelectedRiskLevel))">All Standing Statuses</option>
                <option value="AtRisk" selected="@(Model.SelectedRiskLevel == "AtRisk")">All Flagged At-Risk Only</option>
                <option value="High" selected="@(Model.SelectedRiskLevel == "High")">High Risk Only</option>
                <option value="Medium" selected="@(Model.SelectedRiskLevel == "Medium")">Medium Risk Only</option>
                <option value="Normal" selected="@(Model.SelectedRiskLevel == "Normal")">Normal Standing Only</option>
            </select>
        </div>

        <!-- Risk Category Filter -->
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold">Filter</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.SelectedDepartment) || (!string.IsNullOrEmpty(Model.SelectedRiskLevel) && Model.SelectedRiskLevel != "All"))
            {
                <a asp-action="Index" class="btn btn-light border text-muted" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>
</div>

<!-- At-Risk Table -->
<div class="card shadow-sm overflow-hidden">
    <div class="card-heading border-bottom p-3 d-flex align-items-center justify-content-between bg-light-subtle">
        <div class="d-flex align-items-center gap-2">
            <h3 class="h5 mb-0 fw-bold">Evaluated Student Directory</h3>
            <span class="badge bg-secondary rounded-pill px-2 py-1">@Model.AtRiskStudents.Count records</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Thresholds: GPA &lt; 2.25 (High) | Att. &lt; 60% (High)</small>
        </div>
    </div>

    @if (!Model.AtRiskStudents.Any())
    {
        <div class="premium-empty text-center py-5">
            <div class="empty-illustration mb-3">
                <i class="bi bi-shield-check text-success display-4"></i>
            </div>
            <h4 class="fw-bold">No At-Risk Students Found</h4>
            <p class="text-muted">All students matching the selected criteria are in satisfactory academic standing.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Student</th>
                        <th>Department</th>
                        <th>Running GPA</th>
                        <th>Attendance %</th>
                        <th>Risk Severity</th>
                        <th>Risk Reason / Context</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.AtRiskStudents)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar bg-primary-subtle text-primary fw-bold rounded-3 d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                                        @s.FullName[0]
                                    </div>
                                    <div>
                                        <strong class="d-block text-dark">@s.FullName</strong>
                                        <small class="text-muted">ID: @s.RollNumber &bull; @s.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 fw-medium">@s.Department</span>
                                @if (!string.IsNullOrEmpty(s.Semester))
                                {
                                    <small class="d-block text-muted">@s.Semester</small>
                                }
                            </td>
                            <td>
                                @if (s.GradedCoursesCount == 0)
                                {
                                    <span class="text-muted fst-italic">N/A</span>
                                }
                                else if (s.RunningGpa < 2.25m)
                                {
                                    <span class="badge bg-danger text-white px-2 py-1 fw-bold fs-6">@s.RunningGpa.ToString("F2")</span>
                                }
                                else if (s.RunningGpa < 2.75m)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 fw-bold fs-6">@s.RunningGpa.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1 fw-bold fs-6">@s.RunningGpa.ToString("F2")</span>
                                }
                            </td>
                            <td>
                                @if (s.GradedCoursesCount == 0)
                                {
                                    <span class="text-muted fst-italic">N/A</span>
                                }
                                else if (s.AttendancePercent < 60.0m)
                                {
                                    <span class="badge bg-danger text-white px-2 py-1 fw-bold">@s.AttendancePercent.ToString("F1")%</span>
                                }
                                else if (s.AttendancePercent < 75.0m)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 fw-bold">@s.AttendancePercent.ToString("F1")%</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1 fw-bold">@s.AttendancePercent.ToString("F1")%</span>
                                }
                            </td>
                            <td>
                                @if (s.RiskLevel == "High")
                                {
                                    <span class="badge bg-danger text-white px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1 shadow-sm">
                                        <i class="bi bi-exclamation-octagon-fill"></i> HIGH RISK
                                    </span>
                                }
                                else if (s.RiskLevel == "Medium")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1 shadow-sm">
                                        <i class="bi bi-exclamation-triangle-fill"></i> MEDIUM RISK
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                        <i class="bi bi-check-circle-fill"></i> Normal
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="small">
                                    <span class="fw-semibold text-dark">@s.Reason</span>
                                    @if (s.EnrolledCourseCodes.Any())
                                    {
                                        <div class="mt-1">
                                            @foreach (var c in s.EnrolledCourseCodes.Take(3))
                                            {
                                                <span class="course-code me-1 mb-1 d-inline-block">@c</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-controller="Students" asp-action="Details" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-primary rounded-2 px-3 fw-semibold">
                                    <i class="bi bi-eye me-1"></i> Profile
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
