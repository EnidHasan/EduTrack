@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{ var page = ViewContext.RouteData.Values["controller"]?.ToString(); var current = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null; }
<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] · EduTrack</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/login.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/app.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/refinements.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true"/>
</head><body>
@if (User.Identity?.IsAuthenticated == true) {
<aside class="sidebar" id="sidebar"><a class="brand" asp-controller="Dashboard" asp-action="Index"><img src="~/assets/logo2.png" alt="EduTrack Logo" class="brand-logo" /><span>EduTrack<small>Academic OS</small></span></a>
<nav><span class="nav-label">Main menu</span><a class="@(page == "Dashboard" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill text-primary"></i> Overview</a>
@if (User.IsInRole("Teacher")) {<span class="nav-label">Teaching</span><a class="@(page == "Teacher" && ViewContext.RouteData.Values["action"]?.ToString() != "Disputes" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Teacher" asp-action="Index"><i class="bi bi-journal-bookmark-fill text-info"></i> My courses</a><a class="@(page == "Teacher" && ViewContext.RouteData.Values["action"]?.ToString() == "Disputes" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Teacher" asp-action="Disputes"><i class="bi bi-exclamation-triangle-fill text-warning"></i> Grade Disputes</a><a class="@(page == "EarlyWarning" ? "active" : "") d-flex align-items-center gap-3" asp-controller="EarlyWarning" asp-action="Index"><i class="bi bi-shield-exclamation text-danger"></i> Course At-Risk Panel</a>}
@if (User.IsInRole("Admin")) {<span class="nav-label">Administration</span><a class="@(page == "Students" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Students" asp-action="Index"><i class="bi bi-people-fill text-info"></i> Students</a><a class="@(page == "Teachers" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Teachers" asp-action="Index"><i class="bi bi-person-badge-fill text-success"></i> Teachers</a><a class="@(page == "Courses" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Courses" asp-action="Index"><i class="bi bi-layers-fill text-primary"></i> Courses</a><a class="@(page == "Enrollments" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Enrollments" asp-action="Index"><i class="bi bi-clipboard2-check-fill text-warning"></i> Enrollments</a><a class="@(page == "Users" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Users" asp-action="Index"><i class="bi bi-shield-lock-fill text-danger"></i> User accounts</a><span class="nav-label">Analytics & Early Warning</span><a class="@(page == "EarlyWarning" ? "active" : "") d-flex align-items-center gap-3" asp-controller="EarlyWarning" asp-action="Index"><i class="bi bi-shield-exclamation text-danger"></i> At-Risk Warning Panel</a><a class="@(page == "Reports" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line-fill text-primary"></i> System Reports</a>}
@if (User.IsInRole("Student")) {<span class="nav-label">Academic</span><a class="@(page == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Student" asp-action="Index"><i class="bi bi-file-earmark-text-fill text-info"></i> My Transcript</a><a class="@(page == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "Disputes" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Student" asp-action="Disputes"><i class="bi bi-exclamation-triangle-fill text-warning"></i> My Disputes</a>}
<span class="nav-label">Account</span><a class="@(page == "Account" ? "active" : "") d-flex align-items-center gap-3" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle text-primary"></i> My profile</a></nav>
<div class="sidebar-foot"><div class="avatar">@((current?.FullName ?? "U")[0])</div><div><strong>@(current?.FullName)</strong><small>@(current?.ProfileType ?? "Member")</small></div></div></aside>
<div class="app-shell"><header class="topbar"><div class="d-flex gap-3 align-items-center"><button id="menuButton" class="menu-btn" aria-label="Toggle menu">&#9776;</button><div><span class="eyebrow">UNIVERSITY ACADEMIC PORTAL</span><strong>@ViewData["Title"]</strong></div></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="logout-btn" type="submit"><span class="logout-icon">&#8599;</span><span>Sign out</span></button></form></header>
<main class="content">@if (TempData["Success"] is string success) { <div class="notice success">✓ @success</div> } @if (TempData["Error"] is string error) { <div class="notice error">! @error</div> } @RenderBody()</main></div><div class="overlay" id="overlay"></div>
} else { <main>@RenderBody()</main> }
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
