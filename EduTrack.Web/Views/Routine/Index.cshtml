@model IEnumerable<EduTrack.Web.Models.ClassRoutine>

@{
    ViewData["Title"] = "Master Class Routine";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Create New Block</a>
</div>

@{
    var semesters = new[] { "1.1", "1.2", "2.1", "2.2", "3.1", "3.2", "4.1", "4.2" };
    var currentSemester = ViewBag.CurrentSemester as string ?? "1.1";
}

<ul class="nav nav-pills mb-4">
    @foreach(var sem in semesters)
    {
        <li class="nav-item">
            <a class="nav-link @(currentSemester == sem ? "active" : "")" asp-action="Index" asp-route-semester="@sem">
                Semester @sem
            </a>
        </li>
    }
</ul>

<table class="table table-striped premium-table">
    <thead>
        <tr>
            <th>Course</th>
            <th>Type</th>
            <th>Sec / Group</th>
            <th>Day</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Room</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td class="fw-bold">@item.Course?.CourseName (@item.Course?.CourseCode)</td>
            <td>
                @if (item.ClassType == "Lab")
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-laptop me-1"></i>Lab (2.5h)</span>
                }
                else
                {
                    <span class="badge bg-info text-dark"><i class="bi bi-book me-1"></i>Theory (50m)</span>
                }
            </td>
            <td><span class="fw-semibold">@item.Section</span></td>
            <td>@item.DayOfWeek</td>
            <td>@item.StartTime.ToString(@"hh\:mm")</td>
            <td>@item.EndTime.ToString(@"hh\:mm")</td>
            <td>@item.RoomNumber</td>
            <td>
                <div class="routine-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="routine-action routine-action-edit"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="routine-action routine-action-delete"><i class="bi bi-trash3" aria-hidden="true"></i> Delete</a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
