@model Teacher
@{ ViewData["Title"] = Model.Id == 0 ? "Add teacher" : "Edit teacher"; }
<div class="page-head"><div><span class="eyebrow">FACULTY ADMINISTRATION</span><h1>@ViewData["Title"]</h1><p>@(Model.Id == 0 ? "Create the faculty profile and secure login account together." : "Update the faculty member's official information.")</p></div><a class="btn-soft" asp-action="Index">← Back to teachers</a></div>
<form asp-action="Save" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly"></div>
@if(Model.Id == 0){<div class="credential-banner"><span>⌁</span><div><strong>First-login credentials</strong><p>The teacher will sign in with this email and temporary password, then must choose a private password immediately.</p></div></div>}
<div class="form-section"><div class="form-section-title"><span>01</span><div><strong>Faculty identity</strong><small>Official personal and employment identifiers</small></div></div><div class="row g-4"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" placeholder="Faculty member's full name"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="EmployeeId" class="form-label"></label><input asp-for="EmployeeId" class="form-control" placeholder="Official employee ID"/><span asp-validation-for="EmployeeId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="faculty@university.edu"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" placeholder="e.g. Economics"/><span asp-validation-for="Department" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Designation" class="form-label"></label><input asp-for="Designation" class="form-control" placeholder="e.g. Assistant Professor"/></div></div></div>
@if(Model.Id == 0){<div class="form-section credential-section"><div class="form-section-title"><span>02</span><div><strong>Secure account access</strong><small>One-time credentials for the teacher's first login</small></div></div><div class="row"><div class="col-md-6"><label asp-for="TemporaryPassword" class="form-label"></label><input asp-for="TemporaryPassword" class="form-control" placeholder="Create a strong temporary password" autocomplete="new-password"/><span asp-validation-for="TemporaryPassword" class="text-danger small"></span><div class="password-rules">8+ characters · uppercase · lowercase · number · symbol</div></div></div></div>}
<div class="form-footer"><label class="switch-control"><input asp-for="IsActive"/><span></span><div><strong>Active teacher</strong><small>Allow this account to access EduTrack</small></div></label><button class="btn-primary">@(Model.Id == 0 ? "Create teacher & account" : "Save changes")</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
