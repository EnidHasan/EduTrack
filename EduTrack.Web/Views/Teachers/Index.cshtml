@model IEnumerable<Teacher>
@{ ViewData["Title"] = "Teachers"; }
<div class="page-head module-head">
    <div class="module-heading"><span class="module-symbol"><i class="bi bi-person-badge-fill"></i></span><div><span class="eyebrow">FACULTY AFFAIRS</span><h1>Faculty directory</h1><p>Manage educators, institutional profiles and teaching identities.</p></div></div>
    <div class="d-flex gap-2"><form class="search"><i class="bi bi-search"></i><input name="q" value="@ViewBag.Query" placeholder="Search teachers..."/><button>Search</button></form><a class="btn-primary" asp-action="Create"><i class="bi bi-person-plus-fill"></i> Add teacher</a></div>
</div>
<div class="directory-meta"><span><i class="bi bi-person-workspace"></i><strong>@Model.Count()</strong> faculty members</span><small><i class="bi bi-building-check"></i> University teaching directory</small></div>
<div class="card table-responsive directory-card"><table class="table"><thead><tr><th>Teacher</th><th>Employee ID</th><th>Department</th><th>Designation</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><div class="identity-cell"><span class="record-avatar teacher-avatar">@x.FullName[0]</span><div><strong>@x.FullName</strong><div class="field-note">@x.Email</div></div></div></td><td><span class="metadata-code">@x.EmployeeId</span></td><td><span class="department-pill">@x.Department</span></td><td><strong>@(x.Designation ?? "Not specified")</strong></td><td><span class="status @(x.IsActive ? "" : "off")"><i class="bi @(x.IsActive ? "bi-check-circle-fill" : "bi-pause-circle")"></i> @(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-pencil-square"></i><span>Edit</span></a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id"><i class="bi bi-trash3"></i><span>Delete</span></a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty luxury-empty"><span><i class="bi bi-person-badge"></i></span><h4>No faculty members found</h4><p>Add teaching personnel or adjust your search.</p><a class="btn-primary" asp-action="Create">Add first teacher</a></div>}</div>
