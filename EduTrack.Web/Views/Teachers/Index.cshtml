@model IEnumerable<Teacher>
@{ ViewData["Title"] = "Teachers"; }
<div class="page-head"><div><h1>Faculty directory</h1><p>Manage teachers and their institutional profiles.</p></div><div class="d-flex gap-2"><form class="search"><input name="q" value="@ViewBag.Query" placeholder="Search teachers..."/><button>Search</button></form><a class="btn-primary" asp-action="Create">＋ Add teacher</a></div></div><div class="card table-responsive"><table class="table"><thead><tr><th>Teacher</th><th>Employee ID</th><th>Department</th><th>Designation</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.FullName</strong><div class="field-note">@x.Email</div></td><td>@x.EmployeeId</td><td>@x.Department</td><td>@(x.Designation ?? "—")</td><td><span class="status @(x.IsActive ? "" : "off")">@(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id">Edit</a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id">Delete</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No teachers found.</div>}</div>
