@model Teacher
@{ ViewData["Title"] = "Delete teacher"; }
<div class="card danger-zone"><h2>Delete @Model.FullName?</h2><p class="text-secondary">This permanently removes teacher <strong>@Model.EmployeeId</strong>. Assigned courses will become unassigned.</p><form method="post"><input type="hidden" name="id" value="@Model.Id"/><a class="btn-soft" asp-action="Index">Cancel</a><button class="btn-danger-soft ms-2">Delete permanently</button></form></div>
