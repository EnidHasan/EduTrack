@model Enrollment
@{ ViewData["Title"] = "Delete enrollment"; }
<div class="card danger-zone"><h2>Delete enrollment for @Model.Student?.FullName?</h2><p class="text-secondary">This permanently removes the enrollment in <strong>@Model.Course?.CourseCode</strong>. Any associated grade will also be deleted.</p><form method="post"><input type="hidden" name="id" value="@Model.Id"/><a class="btn-soft" asp-action="Index">Cancel</a><button class="btn-danger-soft ms-2">Delete permanently</button></form></div>
