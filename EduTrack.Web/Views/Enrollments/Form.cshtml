@model Enrollment
@{ ViewData["Title"] = Model.Id == 0 ? "Add enrollment" : "Edit enrollment"; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Map a student to a course.</p></div><a class="btn-soft" asp-action="Index">← Back to enrollments</a></div><form asp-action="Save" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly"></div><div class="row g-4"><div class="col-md-6"><label asp-for="StudentId" class="form-label"></label><select asp-for="StudentId" asp-items="ViewBag.StudentId" class="form-select"><option value="">Select student</option></select><span asp-validation-for="StudentId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="CourseId" class="form-label"></label><select asp-for="CourseId" asp-items="ViewBag.CourseId" class="form-select"><option value="">Select course</option></select><span asp-validation-for="CourseId" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="Semester" class="form-label"></label><input asp-for="Semester" class="form-control" placeholder="Fall 2026"/></div><div class="col-md-4"><label asp-for="AcademicYear" class="form-label"></label><input asp-for="AcademicYear" class="form-control"/></div><div class="col-md-4"><label asp-for="EnrolledOn" class="form-label"></label><input asp-for="EnrolledOn" class="form-control" type="date"/></div><div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Active enrollment</label></div><div class="col-12"><button class="btn-primary">Save enrollment</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
