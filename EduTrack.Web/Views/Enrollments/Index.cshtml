@model IEnumerable<Enrollment>
@{ ViewData["Title"] = "Enrollments"; }
<div class="page-head module-head">
    <div class="module-heading"><span class="module-symbol"><i class="bi bi-clipboard2-check-fill"></i></span><div><span class="eyebrow">ACADEMIC PLACEMENT</span><h1>Enrollment registry</h1><p>Connect learners with courses and maintain their academic placement.</p></div></div>
    <div class="d-flex gap-2"><form class="search"><i class="bi bi-search"></i><input name="q" value="@ViewBag.Query" placeholder="Search enrollments..."/><button>Search</button></form><a class="btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add enrollment</a></div>
</div>
<div class="directory-meta"><span><i class="bi bi-link-45deg"></i><strong>@Model.Count()</strong> student-course links</span><small><i class="bi bi-calendar-check"></i> Current academic registry</small></div>
<div class="card table-responsive directory-card"><table class="table"><thead><tr><th>Student</th><th>Course</th><th>Semester</th><th>Academic year</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><div class="identity-cell"><span class="record-avatar student-avatar">@((x.Student?.FullName ?? "S")[0])</span><div><strong>@x.Student?.FullName</strong><div class="field-note">Student enrollment</div></div></div></td><td><span class="metadata-code">@x.Course?.CourseCode</span><div class="field-note">@x.Course?.CourseName</div></td><td><span class="department-pill">@(x.Semester ?? "Not specified")</span></td><td><strong>@x.AcademicYear</strong></td><td>@x.EnrolledOn.ToString("dd MMM yyyy")</td><td><span class="status @(x.IsActive ? "" : "off")"><i class="bi @(x.IsActive ? "bi-check-circle-fill" : "bi-pause-circle")"></i> @(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-pencil-square"></i><span>Edit</span></a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id"><i class="bi bi-trash3"></i><span>Delete</span></a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty luxury-empty"><span><i class="bi bi-clipboard2-plus"></i></span><h4>No enrollments found</h4><p>Connect a student to a course or adjust your search.</p><a class="btn-primary" asp-action="Create">Add first enrollment</a></div>}</div>
