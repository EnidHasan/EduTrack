@model IEnumerable<Enrollment>
@{ ViewData["Title"] = "Enrollments"; }
<div class="page-head"><div><h1>Enrollments</h1><p>Manage student-course mappings.</p></div><div class="d-flex gap-2"><form class="search"><input name="q" value="@ViewBag.Query" placeholder="Search enrollments..."/><button>Search</button></form><a class="btn-primary" asp-action="Create">＋ Add enrollment</a></div></div><div class="card table-responsive"><table class="table"><thead><tr><th>Student</th><th>Course</th><th>Semester</th><th>Academic year</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Student?.FullName</td><td><strong>@x.Course?.CourseCode</strong> @x.Course?.CourseName</td><td>@(x.Semester ?? "—")</td><td>@x.AcademicYear</td><td>@x.EnrolledOn.ToShortDateString()</td><td><span class="status @(x.IsActive ? "" : "off")">@(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id">Edit</a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id">Delete</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No enrollments found.</div>}</div>
