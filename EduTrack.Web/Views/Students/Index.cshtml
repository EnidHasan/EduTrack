@model IEnumerable<Student>
@{ ViewData["Title"] = "Students"; }
<div class="page-head module-head">
    <div class="module-heading"><span class="module-symbol"><i class="bi bi-mortarboard-fill"></i></span><div><span class="eyebrow">STUDENT AFFAIRS</span><h1>Student records</h1><p>Maintain learner profiles and academic identities across the university.</p></div></div>
    <div class="d-flex gap-2"><form class="search"><i class="bi bi-search"></i><input name="q" value="@ViewBag.Query" placeholder="Search students..."/><button>Search</button></form><a class="btn-primary" asp-action="Create"><i class="bi bi-person-plus-fill"></i> Add student</a></div>
</div>
<div class="directory-meta"><span><i class="bi bi-people-fill"></i><strong>@Model.Count()</strong> student records</span><small><i class="bi bi-shield-check"></i> Identity-linked academic profiles</small></div>
<div class="card table-responsive directory-card"><table class="table"><thead><tr><th>Student</th><th>Roll</th><th>Department</th><th>Year / Semester</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><div class="identity-cell"><span class="record-avatar student-avatar">@x.FullName[0]</span><div><strong>@x.FullName</strong><div class="field-note">@x.Email</div></div></div></td><td><span class="metadata-code">@x.RollNumber</span></td><td><span class="department-pill">@x.Department</span></td><td><strong>@x.EnrollmentYear</strong><div class="field-note">@(x.Semester ?? "Not specified")</div></td><td><span class="status @(x.IsActive ? "" : "off")"><i class="bi @(x.IsActive ? "bi-check-circle-fill" : "bi-pause-circle")"></i> @(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Details" asp-route-id="@x.Id"><i class="bi bi-eye"></i><span>View</span></a><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-pencil-square"></i><span>Edit</span></a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id"><i class="bi bi-trash3"></i><span>Delete</span></a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty luxury-empty"><span><i class="bi bi-mortarboard"></i></span><h4>No students found</h4><p>Create the first learner profile or adjust your search.</p><a class="btn-primary" asp-action="Create">Add first student</a></div>}</div>
