@model IEnumerable<Student>
@{ ViewData["Title"] = "Students"; }
<div class="page-head"><div><h1>Student records</h1><p>Maintain learner profiles and academic identities.</p></div><div class="d-flex gap-2"><form class="search"><input name="q" value="@ViewBag.Query" placeholder="Search students..."/><button>Search</button></form><a class="btn-primary" asp-action="Create">＋ Add student</a></div></div><div class="card table-responsive"><table class="table"><thead><tr><th>Student</th><th>Roll</th><th>Department</th><th>Year / Semester</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.FullName</strong><div class="field-note">@x.Email</div></td><td>@x.RollNumber</td><td>@x.Department</td><td>@x.EnrollmentYear · @(x.Semester ?? "—")</td><td><span class="status @(x.IsActive ? "" : "off")">@(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id">Edit</a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id">Delete</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No students found.</div>}</div>
