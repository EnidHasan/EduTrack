@model Student
@{ ViewData["Title"] = Model.Id == 0 ? "Add student" : "Edit student"; }
<div class="page-head"><div><span class="eyebrow">STUDENT ADMINISTRATION</span><h1>@ViewData["Title"]</h1><p>@(Model.Id == 0 ? "Create the academic profile and secure login account together." : "Update the student's official academic information.")</p></div><a class="btn-soft" asp-action="Index">← Back to students</a></div>
<form asp-action="Save" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly"></div>
@if(Model.Id == 0){<div class="credential-banner"><span>⌁</span><div><strong>First-login credentials</strong><p>The student will sign in with this email and temporary password, then must choose a private password immediately.</p></div></div>}
<div class="form-section"><div class="form-section-title"><span>01</span><div><strong>Academic identity</strong><small>Official personal and university identifiers</small></div></div><div class="row g-4"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" placeholder="Student's full name"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="RollNumber" class="form-label"></label><input asp-for="RollNumber" class="form-control" placeholder="Official student ID"/><span asp-validation-for="RollNumber" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="student@university.edu"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" placeholder="e.g. Business Administration"/><span asp-validation-for="Department" class="text-danger small"></span></div></div></div>
<div class="form-section"><div class="form-section-title"><span>02</span><div><strong>Academic placement</strong><small>Enrollment period and current status</small></div></div><div class="row g-4"><div class="col-md-6"><label asp-for="EnrollmentYear" class="form-label"></label><input asp-for="EnrollmentYear" class="form-control"/><span asp-validation-for="EnrollmentYear" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Semester" class="form-label"></label><input asp-for="Semester" class="form-control" placeholder="e.g. Fall 2026"/></div></div></div>
@if(Model.Id == 0){<div class="form-section credential-section"><div class="form-section-title"><span>03</span><div><strong>Secure account access</strong><small>One-time credentials for the student's first login</small></div></div><div class="row"><div class="col-md-6"><label asp-for="TemporaryPassword" class="form-label"></label><input asp-for="TemporaryPassword" class="form-control" placeholder="Create a strong temporary password" autocomplete="new-password"/><span asp-validation-for="TemporaryPassword" class="text-danger small"></span><div class="password-rules">8+ characters · uppercase · lowercase · number · symbol</div></div></div></div>}
<div class="form-footer"><label class="switch-control"><input asp-for="IsActive"/><span></span><div><strong>Active student</strong><small>Allow this account to access EduTrack</small></div></label><button class="btn-primary">@(Model.Id == 0 ? "Create student & account" : "Save changes")</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
