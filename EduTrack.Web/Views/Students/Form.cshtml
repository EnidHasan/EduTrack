@model Student
@{ ViewData["Title"] = Model.Id == 0 ? "Add student" : "Edit student"; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Provide the student's official academic information.</p></div><a class="btn-soft" asp-action="Index">← Back to students</a></div><form asp-action="Save" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly"></div><div class="row g-4"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="RollNumber" class="form-label"></label><input asp-for="RollNumber" class="form-control"/><span asp-validation-for="RollNumber" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control"/></div><div class="col-md-6"><label asp-for="EnrollmentYear" class="form-label"></label><input asp-for="EnrollmentYear" class="form-control"/></div><div class="col-md-6"><label asp-for="Semester" class="form-label"></label><input asp-for="Semester" class="form-control" placeholder="e.g. Fall 2026"/></div><div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Active student</label></div><div class="col-12"><button class="btn-primary">Save student</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
