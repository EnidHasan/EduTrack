@model Student
@{ ViewData["Title"] = "Delete student"; }
<div class="card danger-zone"><h2>Delete @Model.FullName?</h2><p class="text-secondary">This permanently removes student <strong>@Model.RollNumber</strong>. This cannot be undone.</p><form method="post"><input type="hidden" name="id" value="@Model.Id"/><a class="btn-soft" asp-action="Index">Cancel</a><button class="btn-danger-soft ms-2">Delete permanently</button></form></div>
