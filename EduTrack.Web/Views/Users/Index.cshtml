@model IEnumerable<UserListItem>
@{ ViewData["Title"] = "User accounts"; }
<div class="page-head"><div><h1>Access management</h1><p>Create accounts, assign roles, and control system access.</p></div><div class="d-flex gap-2"><form class="search"><input name="q" value="@ViewBag.Query" placeholder="Search accounts..."/><button>Search</button></form><a class="btn-primary" asp-action="Create">＋ Create account</a></div></div><div class="card table-responsive"><table class="table"><thead><tr><th>User</th><th>Role</th><th>Created</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.FullName</strong><div class="field-note">@x.Email</div></td><td><span class="status">@x.Role</span></td><td>@x.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="status @(x.IsActive ? "" : "off")">@(x.IsActive ? "Active" : "Disabled")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id">Edit</a><form asp-action="Toggle" asp-route-id="@x.Id" method="post"><button class="icon-btn" type="submit">@(x.IsActive ? "Disable" : "Enable")</button></form></div></td></tr>}</tbody></table></div>
