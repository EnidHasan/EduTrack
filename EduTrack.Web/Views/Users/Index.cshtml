@model IEnumerable<UserListItem>
@{ ViewData["Title"] = "User accounts"; }

<div class="page-head module-head">
    <div class="module-heading">
        <span class="module-symbol"><i class="bi bi-shield-lock-fill"></i></span>
        <div><span class="eyebrow">IDENTITY &amp; ACCESS</span><h1>Access management</h1><p>Control institutional identities, account status and role-based access.</p></div>
    </div>
    <div class="d-flex gap-2">
        <form class="search"><i class="bi bi-search"></i><input name="q" value="@ViewBag.Query" placeholder="Search accounts..." /><button>Search</button></form>
        <a class="btn-primary" asp-action="Create"><i class="bi bi-person-plus-fill"></i> Add administrator</a>
    </div>
</div>

<div class="credential-banner account-explainer"><span><i class="bi bi-info-lg"></i></span><div><strong>How accounts work</strong><p>Adding a Student or Teacher automatically creates and links the correct login account. This page controls access and password resets; use “Add administrator” only for another Admin.</p></div></div>

<div class="directory-meta"><span><i class="bi bi-people-fill"></i><strong>@Model.Count()</strong> system identities</span><small><i class="bi bi-shield-check"></i> Secured by ASP.NET Core Identity</small></div>

<div class="card table-responsive directory-card">
    <table class="table">
        <thead><tr><th>User</th><th>Account source</th><th>Role</th><th>Created</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td><div class="identity-cell"><span class="record-avatar account-avatar">@((x.FullName ?? "U")[0])</span><div><strong>@x.FullName</strong><div class="field-note"><i class="bi bi-envelope"></i> @x.Email</div></div></div></td>
                <td><span class="source-badge @(x.IsLinked || x.Role == "Admin" ? "" : "unlinked")">@x.Source</span></td>
                <td><span class="status role-status"><i class="bi bi-person-badge"></i> @x.Role</span></td>
                <td><span class="date-cell"><i class="bi bi-calendar3"></i> @x.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span></td>
                <td><span class="status @(x.IsActive ? "" : "off")"><i class="bi @(x.IsActive ? "bi-check-circle-fill" : "bi-pause-circle")"></i> @(x.IsActive ? "Active" : "Disabled")</span></td>
                <td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-sliders"></i><span>Manage</span></a>@if (!x.IsCurrent){<form asp-action="Toggle" asp-route-id="@x.Id" method="post"><button class="icon-btn" type="submit"><i class="bi @(x.IsActive ? "bi-lock" : "bi-unlock")"></i><span>@(x.IsActive ? "Disable" : "Enable")</span></button></form>}@if (!x.IsLinked && x.Role != "Admin" && !x.IsCurrent){<form asp-action="Delete" asp-route-id="@x.Id" method="post" onsubmit="return confirm('Delete this unlinked login account permanently?');"><button class="icon-btn text-danger" type="submit"><i class="bi bi-trash3"></i><span>Delete</span></button></form>}</div></td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any()) { <div class="empty luxury-empty"><span><i class="bi bi-person-lock"></i></span><h4>No accounts found</h4><p>Try another search or add an administrator.</p></div> }
</div>
