@model IEnumerable<UserListItem>
@{ ViewData["Title"] = "User accounts"; }
<div class="page-head"><div><span class="eyebrow">IDENTITY & ACCESS</span><h1>Access management</h1><p>Control login access for accounts created from Student, Teacher, and Administration records.</p></div><div class="d-flex gap-2"><form class="search"><input name="q" value="@ViewBag.Query" placeholder="Search accounts..."/><button>Search</button></form><a class="btn-primary" asp-action="Create">＋ Add administrator</a></div></div>
<div class="credential-banner account-explainer"><span>i</span><div><strong>How accounts work</strong><p>Adding a Student or Teacher automatically creates and links the correct login account. This page controls access and password resets; use “Add administrator” only for another Admin.</p></div></div>
<div class="card table-responsive"><table class="table"><thead><tr><th>User</th><th>Account source</th><th>Role</th><th>Created</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.FullName</strong><div class="field-note">@x.Email</div></td><td><span class="source-badge @(x.IsLinked || x.Role == "Admin" ? "" : "unlinked")">@x.Source</span></td><td><span class="status role-status">@x.Role</span></td><td>@x.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="status @(x.IsActive ? "" : "off")">@(x.IsActive ? "Active" : "Disabled")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id">Manage</a>@if(!x.IsCurrent){<form asp-action="Toggle" asp-route-id="@x.Id" method="post"><button class="icon-btn" type="submit">@(x.IsActive ? "Disable" : "Enable")</button></form>}@if(!x.IsLinked && x.Role != "Admin" && !x.IsCurrent){<form asp-action="Delete" asp-route-id="@x.Id" method="post" onsubmit="return confirm('Delete this unlinked login account permanently?');"><button class="icon-btn text-danger" type="submit">Delete</button></form>}</div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No accounts found.</div>}</div>
