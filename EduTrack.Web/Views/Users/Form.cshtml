@model UserFormViewModel
@{ ViewData["Title"] = Model.Id is null ? "Add administrator" : "Manage account"; }
<div class="page-head"><div><span class="eyebrow">IDENTITY & ACCESS</span><h1>@ViewData["Title"]</h1><p>@(Model.Id is null ? "Create an additional administrator with secure first-login credentials." : "Manage identity details, access status, and password reset.")</p></div><a class="btn-soft" asp-action="Index">← Back to accounts</a></div>
<form asp-action="Save" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><input asp-for="Role" type="hidden"/><input asp-for="IsRoleLocked" type="hidden"/><input asp-for="LinkedRecord" type="hidden"/><div asp-validation-summary="ModelOnly"></div>
<div class="credential-banner"><span>⌁</span><div><strong>@(Model.Id is null ? "Administrator account" : Model.LinkedRecord)</strong><p>@(Model.Id is null ? "Student and Teacher accounts must be created from their dedicated pages so profiles and roles stay correctly linked." : $"This account's {Model.Role} role is protected and derived from its linked record.")</p></div></div>
<div class="form-section"><div class="form-section-title"><span>01</span><div><strong>Account identity</strong><small>Login name and protected role</small></div></div><div class="row g-4"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label class="form-label">Protected role</label><div class="locked-role"><span>◆</span><div><strong>@Model.Role</strong><small>@Model.LinkedRecord</small></div><b>Locked</b></div></div><div class="col-md-6"><label asp-for="Password" class="form-label">@(Model.Id is null ? "Temporary password" : "Reset password (optional)")</label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password" class="text-danger small"></span><div class="password-rules">@(Model.Id is null ? "The new Admin must change this after first login." : "Leave blank to keep the current password. A reset forces a change at next login.")</div></div></div></div>
<div class="form-footer"><label class="switch-control"><input asp-for="IsActive"/><span></span><div><strong>Account enabled</strong><small>Allow this identity to sign in</small></div></label><button class="btn-primary">@(Model.Id is null ? "Create administrator" : "Save account")</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
