@model UserFormViewModel
@{ ViewData["Title"] = Model.Id is null ? "Create account" : "Edit account"; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Assign secure credentials and the least-privilege role.</p></div><a class="btn-soft" asp-action="Index">← Back to accounts</a></div><form asp-action="Save" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly"></div><div class="row g-4"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Student</option><option>Teacher</option><option>Admin</option></select></div><div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password" class="text-danger small"></span><div class="field-note">@(Model.Id is null ? "Minimum 8 characters with upper, lower, number, and symbol." : "Leave blank to retain the current password.")</div></div><div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Account enabled</label></div><div class="col-12"><button class="btn-primary">Save account</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
