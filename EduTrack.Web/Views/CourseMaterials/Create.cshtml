@model EduTrack.Web.ViewModels.CourseMaterialCreateViewModel
@{
    ViewData["Title"] = "Upload Course Material";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Upload Material for @Model.CourseName (@Model.CourseCode)</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" enctype="multipart/form-data">
                    <input type="hidden" asp-for="CourseId" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., Week 1 Lecture Slides" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the material..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="File" class="form-label fw-bold"></label>
                        <input asp-for="File" type="file" class="form-control" accept=".pdf,.doc,.docx,.ppt,.pptx,.txt" />
                        <span asp-validation-for="File" class="text-danger"></span>
                        <div class="form-text mt-2">
                            <i class="bi bi-info-circle"></i> Allowed formats: PDF, Word, PowerPoint, TXT. Maximum file size: 10MB.
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="TeacherIndex" asp-route-courseId="@Model.CourseId" class="btn btn-light me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-cloud-upload"></i> Upload
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
