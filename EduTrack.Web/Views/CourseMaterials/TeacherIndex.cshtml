@model IEnumerable<EduTrack.Web.Models.CourseMaterial>
@{
    ViewData["Title"] = "Course Materials";
    var course = ViewBag.Course as EduTrack.Web.Models.Course;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Course Materials: @course?.CourseName (@course?.CourseCode)</h2>
    <div>
        <a asp-action="Create" asp-route-courseId="@course?.Id" class="btn btn-primary teacher-material-upload">
            <i class="bi bi-upload"></i> Upload Material
        </a>
        <a asp-controller="Teacher" asp-action="Course" asp-route-id="@course?.Id" class="btn btn-secondary">
            Back to Course
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No materials uploaded for this course yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>File Type</th>
                            <th>Uploaded At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var material in Model)
                        {
                            <tr>
                                <td>@material.Title</td>
                                <td>@(material.Description?.Length > 50 ? material.Description.Substring(0, 47) + "..." : material.Description)</td>
                                <td>@material.OriginalFileName</td>
                                <td>@material.UploadedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="material-admin-actions">
                                        <a asp-action="Download" asp-route-id="@material.Id" class="material-admin-action material-admin-download" target="_blank" title="Download file" aria-label="Download @material.OriginalFileName">
                                            <i class="bi bi-download" aria-hidden="true"></i><span>Download</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@material.Id" class="material-admin-action material-admin-edit" title="Edit material details" aria-label="Edit @material.Title">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i><span>Edit</span>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@material.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this material?');">
                                            <button type="submit" class="material-admin-action material-admin-delete" title="Delete material" aria-label="Delete @material.Title">
                                                <i class="bi bi-trash3" aria-hidden="true"></i><span>Delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
