@model Course
@{ ViewData["Title"] = Model.Id == 0 ? "Add course" : "Edit course"; }
<div class="page-head"><div><h1>@ViewData["Title"]</h1><p>Define curriculum details and teacher ownership.</p></div><a class="btn-soft" asp-action="Index">← Back to courses</a></div><form asp-action="Save" method="post" class="card form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly"></div><div class="row g-4"><div class="col-md-4"><label asp-for="CourseCode" class="form-label"></label><input asp-for="CourseCode" class="form-control" placeholder="e.g. ENG 2101"/><span asp-validation-for="CourseCode" class="text-danger small"></span></div><div class="col-md-8"><label asp-for="CourseName" class="form-label"></label><input asp-for="CourseName" class="form-control"/><span asp-validation-for="CourseName" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="CreditHours" class="form-label"></label><input asp-for="CreditHours" class="form-control" step="0.5"/></div><div class="col-md-4"><label asp-for="Semester" class="form-label"></label><input asp-for="Semester" class="form-control" placeholder="Fall 2026"/></div><div class="col-md-4"><label asp-for="TeacherId" class="form-label"></label><select asp-for="TeacherId" asp-items="ViewBag.TeacherId" class="form-select"><option value="">Unassigned</option></select></div><div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input"/><label asp-for="IsActive" class="form-check-label">Active course</label></div><div class="col-12"><button class="btn-primary">Save course</button></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
