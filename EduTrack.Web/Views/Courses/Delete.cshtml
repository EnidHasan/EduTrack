@model Course
@{ ViewData["Title"] = "Delete course"; }
<div class="card danger-zone"><h2>Delete @Model.CourseCode?</h2><p class="text-secondary">This permanently removes <strong>@Model.CourseName</strong> from the catalog.</p><form method="post"><input type="hidden" name="id" value="@Model.Id"/><a class="btn-soft" asp-action="Index">Cancel</a><button class="btn-danger-soft ms-2">Delete permanently</button></form></div>
