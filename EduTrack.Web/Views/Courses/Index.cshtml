@model IEnumerable<Course>
@{ ViewData["Title"] = "Courses"; }
<div class="page-head module-head">
    <div class="module-heading"><span class="module-symbol"><i class="bi bi-journals"></i></span><div><span class="eyebrow">ACADEMIC CATALOG</span><h1>Course portfolio</h1><p>Shape the curriculum, credit structure and faculty assignments.</p></div></div>
    <div class="d-flex gap-2"><form class="search"><i class="bi bi-search"></i><input name="q" value="@ViewBag.Query" placeholder="Search courses..."/><button>Search</button></form><a class="btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add course</a></div>
</div>
<div class="directory-meta"><span><i class="bi bi-collection-fill"></i><strong>@Model.Count()</strong> catalog courses</span><small><i class="bi bi-diagram-3"></i> Curriculum and faculty mapping</small></div>
<div class="card table-responsive directory-card"><table class="table"><thead><tr><th>Course</th><th>Title</th><th>Credits</th><th>Semester</th><th>Assigned teacher</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><div class="identity-cell"><span class="record-avatar course-avatar"><i class="bi bi-book"></i></span><div><strong class="metadata-code">@x.CourseCode</strong><div class="field-note">Academic course</div></div></div></td><td><strong>@x.CourseName</strong></td><td><span class="credit-badge">@x.CreditHours credits</span></td><td>@(x.Semester ?? "Not specified")</td><td><div class="faculty-cell"><i class="bi bi-person-circle"></i><span>@(x.Teacher?.FullName ?? "Unassigned")</span></div></td><td><span class="status @(x.IsActive ? "" : "off")"><i class="bi @(x.IsActive ? "bi-check-circle-fill" : "bi-pause-circle")"></i> @(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id"><i class="bi bi-pencil-square"></i><span>Edit</span></a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id"><i class="bi bi-trash3"></i><span>Delete</span></a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty luxury-empty"><span><i class="bi bi-journals"></i></span><h4>Your course portfolio is ready</h4><p>Add the first course to begin shaping the curriculum.</p><a class="btn-primary" asp-action="Create">Add first course</a></div>}</div>
