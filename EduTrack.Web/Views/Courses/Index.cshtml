@model IEnumerable<Course>
@{ ViewData["Title"] = "Courses"; }
<div class="page-head"><div><h1>Course catalog</h1><p>Manage curriculum and faculty assignments.</p></div><div class="d-flex gap-2"><form class="search"><input name="q" value="@ViewBag.Query" placeholder="Search courses..."/><button>Search</button></form><a class="btn-primary" asp-action="Create">＋ Add course</a></div></div><div class="card table-responsive"><table class="table"><thead><tr><th>Code</th><th>Course title</th><th>Credits</th><th>Semester</th><th>Assigned teacher</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.CourseCode</strong></td><td>@x.CourseName</td><td>@x.CreditHours</td><td>@(x.Semester ?? "—")</td><td>@(x.Teacher?.FullName ?? "Unassigned")</td><td><span class="status @(x.IsActive ? "" : "off")">@(x.IsActive ? "Active" : "Inactive")</span></td><td><div class="actions"><a class="icon-btn" asp-action="Edit" asp-route-id="@x.Id">Edit</a><a class="icon-btn text-danger" asp-action="Delete" asp-route-id="@x.Id">Delete</a></div></td></tr>}</tbody></table>@if(!Model.Any()){<div class="empty">No courses found.</div>}</div>
