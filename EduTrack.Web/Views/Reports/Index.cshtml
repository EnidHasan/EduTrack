@model EduTrack.Web.ViewModels.SystemReportViewModel
@{
    ViewData["Title"] = "System Academic & At-Risk Summary Reports";
}

<div class="page-head d-flex align-items-center justify-content-between flex-wrap gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-2">
                <i class="bi bi-bar-chart-line-fill me-1"></i> System Analytics Subsystem
            </span>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-2">
                <i class="bi bi-clock me-1"></i> Generated: @Model.GeneratedAt.ToString("MMM dd, yyyy HH:mm")
            </span>
        </div>
        <h1 class="h2 mb-1 fw-bold text-dark">System Academic & Risk Summary Report</h1>
        <p class="text-muted mb-0">Institutional summary metrics, risk distribution analytics, department breakdowns, and course performance.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="ExportPdf"
           asp-route-department="@Model.SelectedDepartment"
           asp-route-semester="@Model.SelectedSemester"
           class="btn export-pdf-btn d-flex align-items-center gap-2 fw-semibold px-3 py-2 rounded-3">
            <i class="bi bi-file-earmark-pdf-fill text-danger"></i> Export PDF
        </a>
    </div>
</div>

<!-- System KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat stat-students h-100">
            <div class="stat-top">
                <i class="bi bi-people-fill">
                    <span>STUDENTS</span>
                </i>
                <span class="trend">Enrolled</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">Total Active Students</small>
            <strong class="d-block text-dark">@Model.TotalStudentsCount</strong>
            <div class="stat-line">
                <span style="width: 100%;"></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat h-100" style="--accent: #dc3545;">
            <div class="stat-top">
                <i class="bi bi-shield-exclamation">
                    <span>RISK</span>
                </i>
                <span class="trend">Flagged</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">Total At-Risk Students</small>
            <strong class="d-block text-danger">@Model.TotalAtRiskCount</strong>
            <div class="stat-line">
                <span style="width: @(Model.TotalStudentsCount > 0 ? (Model.TotalAtRiskCount * 100 / Model.TotalStudentsCount) : 0)%; background: #dc3545;"></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat stat-teachers h-100">
            <div class="stat-top">
                <i class="bi bi-calculator-fill">
                    <span>GPA</span>
                </i>
                <span class="trend">Average</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">System Average GPA</small>
            <strong class="d-block text-primary">@Model.SystemAverageGpa.ToString("F2")</strong>
            <div class="stat-line">
                <span style="width: @(Model.SystemAverageGpa * 100 / 4.0m)%;"></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat stat-users h-100">
            <div class="stat-top">
                <i class="bi bi-calendar-check-fill">
                    <span>ATTEND</span>
                </i>
                <span class="trend">Average</span>
            </div>
            <small class="text-uppercase fw-bold text-muted">System Average Attendance</small>
            <strong class="d-block text-teal">@Model.SystemAverageAttendance.ToString("F1")%</strong>
            <div class="stat-line">
                <span style="width: @Model.SystemAverageAttendance%;"></span>
            </div>
        </div>
    </div>
</div>

<!-- Risk Breakdown Visual Bars -->
<div class="card p-4 mb-4 shadow-sm">
    <h3 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-pie-chart-fill text-primary"></i> System Risk Level & Category Distribution
    </h3>
    <div class="row g-4">
        <!-- Risk Level Breakdown -->
        <div class="col-12 col-md-6">
            <div class="p-3 border rounded-3 bg-light-subtle h-100">
                <h4 class="h6 fw-bold text-uppercase text-muted mb-3">Standing Distribution</h4>

                <!-- Progress Bar -->
                <div class="progress mb-3" style="height: 24px; border-radius: 12px; overflow: hidden;">
                    <div class="progress-bar bg-danger fw-bold" role="progressbar" style="width: @(Model.TotalStudentsCount > 0 ? (Model.HighRiskCount * 100 / Model.TotalStudentsCount) : 0)%" title="High Risk: @Model.HighRiskCount">
                        @if (Model.HighRiskCount > 0) { <span>High (@Model.HighRiskCount)</span> }
                    </div>
                    <div class="progress-bar bg-warning text-dark fw-bold" role="progressbar" style="width: @(Model.TotalStudentsCount > 0 ? (Model.MediumRiskCount * 100 / Model.TotalStudentsCount) : 0)%" title="Medium Risk: @Model.MediumRiskCount">
                        @if (Model.MediumRiskCount > 0) { <span>Med (@Model.MediumRiskCount)</span> }
                    </div>
                    <div class="progress-bar bg-success fw-bold" role="progressbar" style="width: @(Model.TotalStudentsCount > 0 ? (Model.NormalCount * 100 / Model.TotalStudentsCount) : 0)%" title="Normal Standing: @Model.NormalCount">
                        @if (Model.NormalCount > 0) { <span>Normal (@Model.NormalCount)</span> }
                    </div>
                </div>

                <div class="d-flex justify-content-between small text-muted">
                    <span class="d-flex align-items-center gap-1"><i class="bi bi-circle-fill text-danger"></i> High Risk: @Model.HighRiskCount</span>
                    <span class="d-flex align-items-center gap-1"><i class="bi bi-circle-fill text-warning"></i> Medium Risk: @Model.MediumRiskCount</span>
                    <span class="d-flex align-items-center gap-1"><i class="bi bi-circle-fill text-success"></i> Normal: @Model.NormalCount</span>
                </div>
            </div>
        </div>

        <!-- Risk Category Breakdown -->
        <div class="col-12 col-md-6">
            <div class="p-3 border rounded-3 bg-light-subtle h-100">
                <h4 class="h6 fw-bold text-uppercase text-muted mb-3">Primary Risk Cause Breakdown</h4>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="small fw-semibold text-dark"><i class="bi bi-book-half text-danger me-1"></i> Academic Risk Only (GPA &lt; 2.75):</span>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2">@Model.AcademicRiskCount students</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="small fw-semibold text-dark"><i class="bi bi-person-x text-warning me-1"></i> Attendance Risk Only (Att. &lt; 75%):</span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2">@Model.AttendanceRiskCount students</span>
                    </div>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="small fw-semibold text-dark"><i class="bi bi-exclamation-diamond text-danger me-1"></i> Both Academic & Attendance Risk:</span>
                        <span class="badge bg-danger text-white px-2">@Model.BothRiskCount students</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Department Summary Table -->
<div class="card shadow-sm mb-4">
    <div class="card-heading border-bottom p-3">
        <h3 class="h5 mb-0 fw-bold"><i class="bi bi-building me-2 text-primary"></i>Department Performance & Risk Breakdown</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Department Name</th>
                    <th>Total Students</th>
                    <th>At-Risk Count</th>
                    <th>High Risk</th>
                    <th>Medium Risk</th>
                    <th>Avg. GPA</th>
                    <th>Avg. Attendance</th>
                    <th class="pe-4">Risk Rate %</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DepartmentSummaries)
                {
                    <tr>
                        <td class="ps-4 font-monospace fw-bold text-dark">@d.DepartmentName</td>
                        <td>@d.TotalStudents</td>
                        <td>
                            @if (d.AtRiskCount > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger border px-2">@d.AtRiskCount</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success px-2">0</span>
                            }
                        </td>
                        <td><span class="text-danger fw-bold">@d.HighRiskCount</span></td>
                        <td><span class="text-warning fw-bold">@d.MediumRiskCount</span></td>
                        <td class="fw-semibold">@d.AverageGpa.ToString("F2")</td>
                        <td class="fw-semibold">@d.AverageAttendance.ToString("F1")%</td>
                        <td class="pe-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                    <div class="progress-bar bg-danger" style="width: @d.AtRiskPercentage%"></div>
                                </div>
                                <small class="fw-bold">@d.AtRiskPercentage%</small>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Course Summary Table -->
<div class="card shadow-sm">
    <div class="card-heading border-bottom p-3">
        <h3 class="h5 mb-0 fw-bold"><i class="bi bi-journal-text me-2 text-primary"></i>Course Level Performance & Grade Summary</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Course</th>
                    <th>Assigned Instructor</th>
                    <th>Credit Hours</th>
                    <th>Enrolled</th>
                    <th>Graded</th>
                    <th>Avg. Total Mark</th>
                    <th>Pass Rate</th>
                    <th class="pe-4">At-Risk Enrolled</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.CourseSummaries)
                {
                    <tr>
                        <td class="ps-4">
                            <strong class="d-block text-dark">@c.CourseCode</strong>
                            <small class="text-muted">@c.CourseTitle</small>
                        </td>
                        <td><span class="fw-medium text-dark">@c.TeacherName</span></td>
                        <td>@c.CreditHours.ToString("F1")</td>
                        <td>@c.TotalEnrolled</td>
                        <td>@c.GradedCount</td>
                        <td class="fw-bold text-primary">@c.AverageTotalMark.ToString("F1") / 100</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(c.PassRatePercent >= 75.0m ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") border px-2">
                                    @c.PassRatePercent% Pass
                                </span>
                                <small class="text-muted">(@c.PassCount P / @c.FailCount F)</small>
                            </div>
                        </td>
                        <td class="pe-4">
                            @if (c.AtRiskEnrolledCount > 0)
                            {
                                <span class="badge bg-danger text-white px-2 py-1">@c.AtRiskEnrolledCount At-Risk</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success px-2">0</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
